{
  "name": "dsh-lh-data",
  "version": "0.2.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/linkedshine/dsh-lh-data.git"
  },
  "description": "dsh 插件：把工作区 Excel/CSV 导入本地 Turso（libSQL），并以句柄化的 dataset_* 工具做增删改查。",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib/",
    "src/",
    "cordis.patch.yml"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "tsdown",
    "prepublishOnly": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "typecheck:host": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json --noEmit",
    "import": "node examples/run-import.mjs",
    "view": "node examples/run-view.mjs",
    "admin": "node examples/run-admin.mjs",
    "datasource": "node examples/run-datasource.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "external": [
        "react"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@libsql/client": "^0.17.4",
    "mysql2": "^3.24.3",
    "papaparse": "^5.7.0",
    "pg": "^8.23.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.31",
    "tsdown": "^0.4.0",
    "typescript": "^5.5.4"
  }
}
